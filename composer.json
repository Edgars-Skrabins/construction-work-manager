{
    "name": "edgars-skrabins/construction-work-manager",
    "type": "project",
    "description": "Work management module for construction sites",
    "license": "MIT",
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./yii serve"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": [
            "@php tests/recreate-test-database.php",
            "@putenv APP_ENV=test",
            "@php ./yii migrate:up --no-interaction",
            "phpunit --testsuite integration"
        ],
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "require": {
        "php": "8.4.*",
        "ext-filter": "*",
        "ext-pdo_sqlsrv": "*",
        "httpsoft/http-message": "^1.1.6",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "symfony/console": "^7.4.7 || ^8.1.10",
        "twbs/bootstrap": "^5.3.8",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/cache": "^3.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/db-migration": "^2.2.0",
        "yiisoft/db-mssql": "^2.0",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/html": "^4.2",
        "yiisoft/http": "^1.3",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/log": "^2.2.1",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/session": "^3.0.3",
        "yiisoft/view": "^12.2.4",
        "yiisoft/view-twig": "^3.0",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.4.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/phpstan": "^2.3.3",
        "phpunit/phpunit": "^13.4.5",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "yiisoft/config": true,
            "composer/installers": true
        }
    }
}
