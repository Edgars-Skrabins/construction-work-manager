{% do this.setTitle(t('Assignment details')) %}
<div class="row justify-content-center">
    <div class="col-lg-8" data-modal-content>
        <h1 class="h3 mb-4" data-modal-title>{{ t('Assignment details') }}</h1>
        {% include 'Web/MyAssignmentDetails/details.twig' with {work: work, status: status} %}
        <a class="btn btn-link touch-link px-0 mt-3" href="{{ urlGenerator.generate('my-assignments') }}" data-modal-cancel>{{ t('Back to my assignments') }}</a>
    </div>
</div>
