{% do this.setTitle(t('Work calendar')) %}
{% set month = calendar.month() %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">{{ t('Work calendar') }}</h1>
    <a class="btn btn-outline-secondary" href="{{ urlGenerator.generate('employee.list') }}">{{ t('Employees list') }}</a>
</div>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    {% include 'Web/Shared/Calendar/month-nav.twig' with {calendar: calendar, route: 'employee.calendar', query: {employee: employeeId}} %}
    <form class="d-flex align-items-center gap-2" method="get" action="{{ urlGenerator.generate('employee.calendar') }}" data-calendar-picker>
        <input type="hidden" name="month" value="{{ month|date('Y-m') }}">
        <label class="visually-hidden" for="calendar-employee">{{ t('Employee') }}</label>
        <select class="form-select form-select-sm" id="calendar-employee" name="employee">
            <option value="">{{ t('All employees') }}</option>
            {% for employee in team %}
                <option value="{{ employee.id }}"{% if employee.id == employeeId %} selected{% endif %}>{{ employee.lastName }}, {{ employee.firstName }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-sm btn-primary calendar-picker-submit">{{ t('Show') }}</button>
    </form>
</div>
{% include 'Web/Shared/Calendar/month.twig' with {weeks: weeks, entries: entries, statuses: statuses, showEmployee: true} %}
