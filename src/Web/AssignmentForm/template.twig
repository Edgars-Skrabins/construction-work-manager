{% set title = item ? t('Edit assignment') : t('New assignment') %}
{% do this.setTitle(title) %}
{% do assetManager.register('App\\Web\\Shared\\Layout\\Main\\AssignmentAsset') %}
<div class="row justify-content-center">
    <div class="col-lg-8" data-modal-content>
        <h1 class="h3 mb-4" data-modal-title>{{ title }}</h1>
        <form method="post" action="{{ item ? urlGenerator.generate('assignment.edit', {id: item.assignment.id}) : urlGenerator.generate('assignment.create') }}" novalidate>
            {{ csrf.hiddenInput()|raw }}
            {% if item %}
                <input type="hidden" name="currentEmployee" value="{{ form.currentEmployee }}">
            {% endif %}
            <div class="mb-3">
                <label for="employee" class="form-label">{{ t('Employee') }}</label>
                <select class="form-select{% if errors.employee is defined or (item and errors.constructionSite is defined) %} is-invalid{% endif %}" id="employee" name="employee" required>
                    <option value="">{{ t('Choose…') }}</option>
                    {% if item and item.assignment.employeeId not in options.employees|map(employee => employee.id) %}
                        <option value="{{ item.assignment.employeeId }}" data-access-level="{{ item.employeeAccessLevel }}"{% if form.employee == item.assignment.employeeId ~ '' %} selected{% endif %}>{{ t('{name} – access level {level}', {name: item.employeeName, level: item.employeeLevel().label()}) }}</option>
                    {% endif %}
                    {% for employee in options.employees %}
                        <option value="{{ employee.id }}" data-access-level="{{ employee.accessLevelId }}"{% if form.employee == employee.id ~ '' %} selected{% endif %}>{{ t('{name} – access level {level}', {name: employee.fullName(), level: options.accessLevels[employee.accessLevelId].label()}) }}</option>
                    {% endfor %}
                </select>
                {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.employee ?? []} %}
                {% if item %}
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.constructionSite ?? []} %}
                {% endif %}
            </div>
            {% if item %}
                <dl class="row">
                    <dt class="col-sm-4">{{ t('Work item') }}</dt>
                    <dd class="col-sm-8">{{ item.workItemName }}</dd>
                    <dt class="col-sm-4">{{ t('Construction site') }}</dt>
                    <dd class="col-sm-8">{{ item.constructionSiteName }}</dd>
                </dl>
            {% else %}
                <div class="mb-3">
                    <label for="workItem" class="form-label">{{ t('Work item') }}</label>
                    <select class="form-select{% if errors.workItem is defined %} is-invalid{% endif %}" id="workItem" name="workItem" required>
                        <option value="">{{ t('Choose…') }}</option>
                        {% for workItem in options.workItems %}
                            <option value="{{ workItem.id }}"{% if form.workItem == workItem.id ~ '' %} selected{% endif %}>{{ workItem.name }}</option>
                        {% endfor %}
                    </select>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.workItem ?? []} %}
                </div>
                <div class="mb-3">
                    <label for="constructionSite" class="form-label">{{ t('Construction site') }}</label>
                    <select class="form-select{% if errors.constructionSite is defined %} is-invalid{% endif %}" id="constructionSite" name="constructionSite" required>
                        <option value="">{{ t('Choose…') }}</option>
                        {% for site in options.sites %}
                            <option value="{{ site.id }}" data-required-level="{{ site.requiredAccessLevelId }}"{% if form.constructionSite == site.id ~ '' %} selected{% endif %}>{{ t('{name} – requires {level}', {name: site.name, level: site.requiredAccessLevel().label()}) }}</option>
                        {% endfor %}
                    </select>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.constructionSite ?? []} %}
                </div>
            {% endif %}
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label for="startDate" class="form-label">{{ t('Start date') }}</label>
                    {% include 'Web/Shared/Form/date-input.twig' with {id: 'startDate', value: form.startDate, invalid: errors.startDate is defined, required: true} %}
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.startDate ?? []} %}
                </div>
                <div class="col-sm-6 mb-3">
                    <label for="endDate" class="form-label">{{ t('End date') }}</label>
                    {% include 'Web/Shared/Form/date-input.twig' with {id: 'endDate', value: form.endDate, invalid: errors.endDate is defined, required: true} %}
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.endDate ?? []} %}
                </div>
            </div>
            {% if item %}
                <div class="mb-3">
                    <label for="status" class="form-label">{{ t('Status') }}</label>
                    <select class="form-select{% if errors.status is defined %} is-invalid{% endif %}" id="status" name="status" required>
                        {% for status in statuses %}
                            <option value="{{ status.value }}"{% if form.status == status.value %} selected{% endif %}>{{ t(status.label()) }}</option>
                        {% endfor %}
                    </select>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.status ?? []} %}
                </div>
            {% endif %}
            <button type="submit" class="btn btn-primary">{{ t('Save') }}</button>
            <a class="btn btn-link" href="{{ urlGenerator.generate('assignment.list') }}" data-modal-cancel>{{ t('Cancel') }}</a>
        </form>
    </div>
</div>
