{% set title = item ? 'Edit assignment' : 'New assignment' %}
{% do this.setTitle(title) %}
{% do assetManager.register('App\\Web\\Shared\\Layout\\Main\\AssignmentAsset') %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-4">{{ title }}</h1>
        <form method="post" action="{{ item ? urlGenerator.generate('assignment.edit', {id: item.assignment.id}) : urlGenerator.generate('assignment.create') }}" novalidate>
            {{ csrf.hiddenInput()|raw }}
            {% if item %}
                <dl class="row">
                    <dt class="col-sm-4">Employee</dt>
                    <dd class="col-sm-8">{{ item.employeeName }}</dd>
                    <dt class="col-sm-4">Work item</dt>
                    <dd class="col-sm-8">{{ item.workItemName }}</dd>
                    <dt class="col-sm-4">Construction site</dt>
                    <dd class="col-sm-8">{{ item.constructionSiteName }}</dd>
                </dl>
            {% else %}
                <div class="mb-3">
                    <label for="employee" class="form-label">Employee</label>
                    <select class="form-select{% if errors.employee is defined %} is-invalid{% endif %}" id="employee" name="employee" required>
                        <option value="">Choose…</option>
                        {% for employee in options.employees %}
                            <option value="{{ employee.id }}" data-access-level="{{ employee.accessLevelId }}"{% if form.employee == employee.id ~ '' %} selected{% endif %}>{{ employee.fullName() }} (access level {{ employee.accessLevelId }})</option>
                        {% endfor %}
                    </select>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.employee ?? []} %}
                </div>
                <div class="mb-3">
                    <label for="workItem" class="form-label">Work item</label>
                    <select class="form-select{% if errors.workItem is defined %} is-invalid{% endif %}" id="workItem" name="workItem" required>
                        <option value="">Choose…</option>
                        {% for workItem in options.workItems %}
                            <option value="{{ workItem.id }}"{% if form.workItem == workItem.id ~ '' %} selected{% endif %}>{{ workItem.name }}</option>
                        {% endfor %}
                    </select>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.workItem ?? []} %}
                </div>
                <div class="mb-3">
                    <label for="constructionSite" class="form-label">Construction site</label>
                    <select class="form-select{% if errors.constructionSite is defined %} is-invalid{% endif %}" id="constructionSite" name="constructionSite" required>
                        <option value="">Choose…</option>
                        {% for site in options.sites %}
                            <option value="{{ site.id }}" data-required-level="{{ site.requiredAccessLevelId }}"{% if form.constructionSite == site.id ~ '' %} selected{% endif %}>{{ site.name }} (requires level {{ site.requiredAccessLevelId }})</option>
                        {% endfor %}
                    </select>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.constructionSite ?? []} %}
                </div>
            {% endif %}
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label for="startDate" class="form-label">Start date</label>
                    <input type="date" class="form-control{% if errors.startDate is defined %} is-invalid{% endif %}" id="startDate" name="startDate" value="{{ form.startDate }}" required>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.startDate ?? []} %}
                </div>
                <div class="col-sm-6 mb-3">
                    <label for="endDate" class="form-label">End date</label>
                    <input type="date" class="form-control{% if errors.endDate is defined %} is-invalid{% endif %}" id="endDate" name="endDate" value="{{ form.endDate }}" required>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.endDate ?? []} %}
                </div>
            </div>
            {% if item %}
                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select{% if errors.status is defined %} is-invalid{% endif %}" id="status" name="status" required>
                        {% for status in statuses %}
                            <option value="{{ status.value }}"{% if form.status == status.value %} selected{% endif %}>{{ status.label() }}</option>
                        {% endfor %}
                    </select>
                    {% include 'Web/Shared/Form/field-errors.twig' with {errors: errors.status ?? []} %}
                </div>
            {% endif %}
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-link" href="{{ urlGenerator.generate('assignment.list') }}">Cancel</a>
        </form>
    </div>
</div>
