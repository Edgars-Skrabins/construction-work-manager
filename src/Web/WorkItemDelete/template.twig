{% do this.setTitle(t('Delete work item')) %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-4">{{ t('Delete work item {name}?', {name: workItem.name}) }}</h1>
        {% if error %}
            <div class="alert alert-danger" role="alert">{{ error }}</div>
        {% else %}
            <form method="post" action="{{ urlGenerator.generate('workItem.delete', {id: workItem.id}) }}" class="d-inline">
                {{ csrf.hiddenInput()|raw }}
                <button type="submit" class="btn btn-danger">{{ t('Delete') }}</button>
            </form>
        {% endif %}
        <a class="btn btn-link" href="{{ urlGenerator.generate('workItem.list') }}">{{ t('Cancel') }}</a>
    </div>
</div>
