{% do this.setTitle(t('Delete work item')) %}
<div class="row justify-content-center">
    <div class="col-lg-8" data-modal-content>
        <h1 class="h3 mb-4" data-modal-title>{{ t('Delete work item {name}?', {name: workItem.name}) }}</h1>
        {% if error %}
            <div class="alert alert-danger" role="alert">{{ error }}</div>
        {% else %}
            <form method="post" action="{{ urlGenerator.generate('workItem.delete', {id: workItem.id}) }}" class="d-inline">
                {{ csrf.hiddenInput()|raw }}
                <button type="submit" class="btn btn-danger">{{ t('Delete') }}</button>
            </form>
        {% endif %}
        {% if error and access.can('assignment.update') %}
            <a class="btn btn-outline-primary" href="{{ urlGenerator.generate('assignment.list', [], {workItem: workItem.id}) }}">{{ t('View assignments') }}</a>
        {% endif %}
        <a class="btn btn-link" href="{{ urlGenerator.generate('workItem.list') }}" data-modal-cancel>{{ t('Cancel') }}</a>
    </div>
</div>
