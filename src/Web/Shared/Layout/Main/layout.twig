{% do assetManager.register('App\\Web\\Shared\\Layout\\Main\\MainAsset') %}
{% do this.addCssFiles(assetManager.getCssFiles()) %}
{% do this.addCssStrings(assetManager.getCssStrings()) %}
{% do this.addJsFiles(assetManager.getJsFiles()) %}
{% do this.addJsStrings(assetManager.getJsStrings()) %}
{% do this.addJsVars(assetManager.getJsVars()) %}
{% do this.beginPage() %}
<!DOCTYPE html>
<html lang="{{ language.current().value }}" data-bs-theme="dark">
<head>
    <meta charset="{{ applicationParams.charset }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="{{ aliases.get('@baseUrl/favicon.svg') }}" type="image/svg+xml">
    <title>{{ this.getTitle() }}</title>
    {% do this.head() %}
</head>
<body class="d-flex flex-column" data-select-search="{{ t('Search') }}" data-select-no-matches="{{ t('No matches') }}">
{% do this.beginBody() %}
<header>
    <nav class="navbar navbar-expand-xl site-navbar">
        <div class="container">
            <span class="navbar-brand">{{ applicationParams.name }}</span>
            <div class="d-flex align-items-center gap-2 ms-auto order-xl-last ms-xl-3">
                {% include 'Web/Shared/Layout/Main/theme-toggle.twig' %}
                {% include 'Web/Shared/Layout/Main/language-selector.twig' %}
                {% if not currentUser.isGuest() %}
                    <form class="d-none d-xl-flex" id="logout-form" method="post" action="{{ urlGenerator.generate('logout') }}">
                        {{ csrf.hiddenInput()|raw }}
                        <button type="submit" class="btn btn-outline-secondary navbar-control">{{ t('Log out') }}</button>
                    </form>
                    <button class="navbar-toggler navbar-control" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar" aria-expanded="false" aria-label="{{ t('Toggle navigation') }}">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                {% endif %}
            </div>
            {% if not currentUser.isGuest() %}
                {% set routeName = currentRoute.getName() ?? '' %}
                <div class="collapse navbar-collapse" id="main-navbar">
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0">
                        {% if access.can('assignment.readOwn') %}
                            <li class="nav-item">
                                {% set active = routeName starts with 'my-assignments' %}
                                <a class="nav-link{% if active %} active{% endif %}"{% if active %} aria-current="page"{% endif %} href="{{ urlGenerator.generate('my-assignments') }}">{{ t('My assignments') }}</a>
                            </li>
                        {% endif %}
                        {% if access.can('employee.list') %}
                            <li class="nav-item">
                                {% set active = routeName starts with 'employee.' %}
                                <a class="nav-link{% if active %} active{% endif %}"{% if active %} aria-current="page"{% endif %} href="{{ urlGenerator.generate('employee.list') }}">{{ t('Employees') }}</a>
                            </li>
                        {% endif %}
                        {% if access.can('site.update') %}
                            <li class="nav-item">
                                {% set active = routeName starts with 'site.' %}
                                <a class="nav-link{% if active %} active{% endif %}"{% if active %} aria-current="page"{% endif %} href="{{ urlGenerator.generate('site.list') }}">{{ t('Construction sites') }}</a>
                            </li>
                        {% endif %}
                        {% if access.can('workItem.update') %}
                            <li class="nav-item">
                                {% set active = routeName starts with 'workItem.' %}
                                <a class="nav-link{% if active %} active{% endif %}"{% if active %} aria-current="page"{% endif %} href="{{ urlGenerator.generate('workItem.list') }}">{{ t('Work items') }}</a>
                            </li>
                        {% endif %}
                        {% if access.can('assignment.update') %}
                            <li class="nav-item">
                                {% set active = routeName starts with 'assignment.' %}
                                <a class="nav-link{% if active %} active{% endif %}"{% if active %} aria-current="page"{% endif %} href="{{ urlGenerator.generate('assignment.list') }}">{{ t('Assignments') }}</a>
                            </li>
                        {% endif %}
                    </ul>
                    {% set account = currentUser.getIdentity().fullName() ~ ' (' ~ t(currentUser.getIdentity().role.value) ~ ')' %}
                    <div class="d-flex align-items-center gap-2 pb-2 pb-xl-0 navbar-account">
                        <span class="navbar-text text-truncate" title="{{ account }}">{{ account }}</span>
                        <button type="submit" form="logout-form" class="btn btn-outline-secondary navbar-control flex-shrink-0 d-xl-none">{{ t('Log out') }}</button>
                    </div>
                </div>
            {% endif %}
        </div>
    </nav>
</header>

<main class="container flex-grow-1 py-4 py-md-5">
    {% for message in flash.success() %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}
    {{ content|raw }}
</main>

<footer class="border-top py-3">
    <div class="container text-center text-secondary small">
        &copy; {{ 'now'|date('Y') }} {{ applicationParams.name }}
    </div>
</footer>
{% do this.endBody() %}
</body>
</html>
{% do this.endPage() %}
