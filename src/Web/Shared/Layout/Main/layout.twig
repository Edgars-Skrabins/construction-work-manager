{% do assetManager.register('App\\Web\\Shared\\Layout\\Main\\MainAsset') %}
{% do this.addCssFiles(assetManager.getCssFiles()) %}
{% do this.addCssStrings(assetManager.getCssStrings()) %}
{% do this.addJsFiles(assetManager.getJsFiles()) %}
{% do this.addJsStrings(assetManager.getJsStrings()) %}
{% do this.addJsVars(assetManager.getJsVars()) %}
{% do this.beginPage() %}
<!DOCTYPE html>
<html lang="{{ applicationParams.locale }}" data-bs-theme="dark">
<head>
    <meta charset="{{ applicationParams.charset }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="{{ aliases.get('@baseUrl/favicon.svg') }}" type="image/svg+xml">
    <title>{{ this.getTitle() }}</title>
    {% do this.head() %}
</head>
<body class="d-flex flex-column">
{% do this.beginBody() %}
<header>
    <nav class="navbar navbar-expand-lg site-navbar">
        <div class="container">
            <a class="navbar-brand" href="{{ aliases.get('@baseUrl') }}">{{ applicationParams.name }}</a>
            {% if not currentUser.isGuest() %}
                {% set routeName = currentRoute.getName() ?? '' %}
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        {% if access.can('assignment.readOwn') %}
                            <li class="nav-item">
                                <a class="nav-link{% if routeName == 'my-assignments' %} active{% endif %}" href="{{ urlGenerator.generate('my-assignments') }}">My assignments</a>
                            </li>
                        {% endif %}
                        {% if access.can('employee.list') %}
                            <li class="nav-item">
                                <a class="nav-link{% if routeName starts with 'employee.' %} active{% endif %}" href="{{ urlGenerator.generate('employee.list') }}">Employees</a>
                            </li>
                        {% endif %}
                        {% if access.can('site.update') %}
                            <li class="nav-item">
                                <a class="nav-link{% if routeName starts with 'site.' %} active{% endif %}" href="{{ urlGenerator.generate('site.list') }}">Construction sites</a>
                            </li>
                        {% endif %}
                        {% if access.can('workItem.update') %}
                            <li class="nav-item">
                                <a class="nav-link{% if routeName starts with 'workItem.' %} active{% endif %}" href="{{ urlGenerator.generate('workItem.list') }}">Work items</a>
                            </li>
                        {% endif %}
                        {% if access.can('assignment.update') %}
                            <li class="nav-item">
                                <a class="nav-link{% if routeName starts with 'assignment.' %} active{% endif %}" href="{{ urlGenerator.generate('assignment.list') }}">Assignments</a>
                            </li>
                        {% endif %}
                    </ul>
                    <form class="d-flex flex-wrap align-items-center gap-2 gap-lg-3 pb-2 pb-lg-0" method="post" action="{{ urlGenerator.generate('logout') }}">
                        {{ csrf.hiddenInput()|raw }}
                        <span class="navbar-text">{{ currentUser.getIdentity().fullName() }} ({{ currentUser.getIdentity().role.value }})</span>
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Log out</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </nav>
</header>

<main class="container flex-grow-1 py-5">
    {% for message in flash.success() %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}
    {{ content|raw }}
</main>

<footer class="border-top py-3">
    <div class="container text-center text-secondary small">
        &copy; {{ 'now'|date('Y') }} {{ applicationParams.name }}
    </div>
</footer>
{% do this.endBody() %}
</body>
</html>
{% do this.endPage() %}
