{% if paginator.isPaginationRequired() %}
    {% set current = paginator.getCurrentPage() %}
    {% set last = paginator.getTotalPages() %}
    {% set sort = paginator.getSort().getOrderAsString() %}
    <nav aria-label="{{ t('Pages') }}">
        <ul class="pagination">
            {% if current > 1 %}
                <li class="page-item"><a class="page-link" href="{{ urlGenerator.generate(route, [], {sort: sort, page: current - 1, q: q ?: null}) }}">{{ t('Previous') }}</a></li>
            {% else %}
                <li class="page-item disabled"><span class="page-link">{{ t('Previous') }}</span></li>
            {% endif %}
            {% set shown = 0 %}
            {% for number in 1..last %}
                {% if number == 1 or number == last or (number - current)|abs <= 2 %}
                    {% if number > shown + 1 %}
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    {% endif %}
                    {% if number == current %}
                        <li class="page-item active" aria-current="page"><span class="page-link">{{ number }}</span></li>
                    {% else %}
                        <li class="page-item"><a class="page-link" href="{{ urlGenerator.generate(route, [], {sort: sort, page: number, q: q ?: null}) }}">{{ number }}</a></li>
                    {% endif %}
                    {% set shown = number %}
                {% endif %}
            {% endfor %}
            {% if current < last %}
                <li class="page-item"><a class="page-link" href="{{ urlGenerator.generate(route, [], {sort: sort, page: current + 1, q: q ?: null}) }}">{{ t('Next') }}</a></li>
            {% else %}
                <li class="page-item disabled"><span class="page-link">{{ t('Next') }}</span></li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
