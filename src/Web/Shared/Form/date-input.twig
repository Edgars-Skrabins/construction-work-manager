{% do assetManager.register('App\\Web\\Shared\\Layout\\Main\\DateInputAsset') %}
<div class="date-input" data-date-input>
    <input type="text" class="form-control{% if invalid ?? false %} is-invalid{% endif %}" id="{{ id }}" name="{{ id }}" value="{{ value }}" inputmode="numeric" pattern="\d{4}-\d{2}-\d{2}" placeholder="YYYY-MM-DD" maxlength="10" autocomplete="off" spellcheck="false"{% if required ?? false %} required{% endif %}>
    <button type="button" class="btn date-input-button" aria-label="{{ t('Choose date') }}" title="{{ t('Choose date') }}" hidden>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>
    </button>
</div>
