<h2 class="visually-hidden">{{ month_year(calendar.month()) }}</h2>
<form class="d-flex align-items-center gap-2" method="get" action="{{ urlGenerator.generate(route) }}" aria-label="{{ t('Go to month') }}" data-calendar-picker>
    {% for name, value in query %}
        {% if value is not null %}
            <input type="hidden" name="{{ name }}" value="{{ value }}">
        {% endif %}
    {% endfor %}
    <label class="visually-hidden" for="calendar-month">{{ t('Month') }}</label>
    <select class="form-select form-select-sm w-auto" id="calendar-month" name="monthOfYear" data-select-plain>
        {% for name in month_names() %}
            {% set value = '%02d'|format(loop.index) %}
            <option value="{{ value }}"{% if value == calendar.month()|date('m') %} selected{% endif %}>{{ name }}</option>
        {% endfor %}
    </select>
    <label class="visually-hidden" for="calendar-year">{{ t('Year') }}</label>
    <select class="form-select form-select-sm w-auto" id="calendar-year" name="year" data-select-plain>
        {% for year in years %}
            <option value="{{ year }}"{% if year == calendar.month()|date('Y') %} selected{% endif %}>{{ year }}</option>
        {% endfor %}
    </select>
    <button type="submit" class="btn btn-sm btn-outline-primary calendar-picker-submit">{{ t('Go') }}</button>
</form>
