<ul class="list-inline small mb-3" aria-label="{{ t('Status legend') }}">
    {% for status in statuses %}
        <li class="list-inline-item"><span class="badge rounded-pill {{ status.badgeClass() }}">&nbsp;</span> {{ t(status.label()) }}</li>
    {% endfor %}
</ul>
{% macro entry(entry, showEmployee) %}
    <li class="mb-1">
        <span class="badge rounded-pill {{ entry.status.badgeClass() }}" title="{{ t(entry.status.label()) }}">&nbsp;</span><span class="visually-hidden">{{ t(entry.status.label()) }}:</span>
        {% if showEmployee %}
            <span class="fw-semibold">{{ entry.item.employeeName }}</span>
            <span class="d-block text-secondary">{{ entry.item.workItemName }} · {{ entry.item.constructionSiteName }}</span>
        {% else %}
            <span class="fw-semibold">{{ entry.item.workItemName }}</span>
            <span class="d-block text-secondary">{{ entry.item.constructionSiteName }}</span>
        {% endif %}
    </li>
{% endmacro %}
<div class="d-none d-md-block">
    <table class="table table-bordered small work-calendar">
        <thead>
            <tr>
                {% for weekday in weekday_names() %}
                    <th scope="col" class="text-center">{{ weekday }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for week in weeks %}
                <tr>
                    {% for day in week %}
                        <td class="{% if day.isToday %}calendar-today{% elseif not day.inMonth %}bg-body text-secondary{% endif %}"{% if day.isToday %} aria-current="date"{% endif %}>
                            <div class="fw-semibold mb-1">{{ day.date|date('j') }}{% if day.isToday %}<span class="visually-hidden"> {{ t('Today') }}</span>{% endif %}</div>
                            {% if day.entries is not empty %}
                                <ul class="list-unstyled mb-0">
                                    {% for entry in day.entries %}
                                        {{ _self.entry(entry, showEmployee) }}
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
<div class="d-md-none">
    {% set shown = 0 %}
    {% for week in weeks %}
        {% for day in week %}
            {% if day.inMonth and day.entries is not empty %}
                {% set shown = shown + 1 %}
                <section class="card mb-2{% if day.isToday %} border-primary{% endif %}"{% if day.isToday %} aria-current="date"{% endif %}>
                    <h3 class="card-header h6{% if day.isToday %} text-bg-primary{% endif %}">{{ weekday_name(day.date) }}, {{ day.date|date('Y-m-d') }}{% if day.isToday %} · {{ t('Today') }}{% endif %}</h3>
                    <ul class="list-unstyled card-body small mb-0">
                        {% for entry in day.entries %}
                            {{ _self.entry(entry, showEmployee) }}
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        {% endfor %}
    {% endfor %}
    {% if shown == 0 %}
        <p class="text-secondary">{{ t('No assigned work this month.') }}</p>
    {% endif %}
</div>
