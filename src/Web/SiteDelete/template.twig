{% do this.setTitle(t('Delete construction site')) %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-4">{{ t('Delete construction site {name}?', {name: site.name}) }}</h1>
        {% if error %}
            <div class="alert alert-danger" role="alert">{{ error }}</div>
        {% else %}
            <form method="post" action="{{ urlGenerator.generate('site.delete', {id: site.id}) }}" class="d-inline">
                {{ csrf.hiddenInput()|raw }}
                <button type="submit" class="btn btn-danger">{{ t('Delete') }}</button>
            </form>
        {% endif %}
        {% if error and access.can('assignment.update') %}
            <a class="btn btn-outline-primary" href="{{ urlGenerator.generate('assignment.list', [], {site: site.id}) }}">{{ t('View assignments') }}</a>
        {% endif %}
        <a class="btn btn-link" href="{{ urlGenerator.generate('site.list') }}">{{ t('Cancel') }}</a>
    </div>
</div>
