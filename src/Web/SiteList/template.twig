{% do this.setTitle(t('Construction sites')) %}
{% set showActions = access.can('site.update') or access.can('site.delete') %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">{{ t('Construction sites') }}</h1>
    <div class="d-flex flex-wrap gap-2">
        {% if access.can('site.create') %}
            <a class="btn btn-primary" href="{{ urlGenerator.generate('site.create') }}" data-modal-link>{{ t('Add construction site') }}</a>
        {% endif %}
    </div>
</div>
{% include 'Web/Shared/Listing/search-form.twig' with {route: 'site.list', placeholder: t('Code, name or address')} %}
<div data-list-results>
    {% if paginator.getTotalItems() == 0 and q != '' %}
        {% include 'Web/Shared/Listing/empty-state.twig' with {message: t('No results for “{query}”.', {query: q})} %}
    {% elseif paginator.getTotalItems() == 0 %}
        {% include 'Web/Shared/Listing/empty-state.twig' with {message: t('No construction sites yet.')} %}
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Code'), key: 'code', route: 'site.list'} %}</th>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Name'), key: 'name', route: 'site.list'} %}</th>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('City'), key: 'city', route: 'site.list'} %}</th>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Country'), key: 'country', route: 'site.list'} %}</th>
                        <th scope="col" class="text-end">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Area (m²)'), key: 'area', route: 'site.list'} %}</th>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Required access level'), key: 'accessLevel', route: 'site.list'} %}</th>
                        {% if showActions %}
                            <th scope="col" class="text-end list-actions">{{ t('Actions') }}</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for site in paginator.read() %}
                        <tr>
                            <td class="text-nowrap">{{ site.code }}</td>
                            <td>{% include 'Web/Shared/Listing/truncated-text.twig' with {text: site.name} %}</td>
                            <td>{% include 'Web/Shared/Listing/truncated-text.twig' with {text: site.city} %}</td>
                            <td>{% include 'Web/Shared/Listing/truncated-text.twig' with {text: site.country} %}</td>
                            <td class="text-end text-nowrap">{{ site.areaM2 }}</td>
                            <td class="text-nowrap">{{ site.requiredAccessLevel().label() }}</td>
                            {% if showActions %}
                                {% set actions = [] %}
                                {% if access.can('site.update') %}
                                    {% set actions = actions|merge([{label: t('Edit'), url: urlGenerator.generate('site.edit', {id: site.id}), variant: 'primary'}]) %}
                                {% endif %}
                                {% if access.can('site.delete') %}
                                    {% set actions = actions|merge([{label: t('Delete'), url: urlGenerator.generate('site.delete', {id: site.id}), variant: 'danger'}]) %}
                                {% endif %}
                                <td class="text-end text-nowrap list-actions">{% include 'Web/Shared/Listing/row-actions.twig' with {name: site.name, actions: actions} %}</td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% include 'Web/Shared/Listing/pagination.twig' with {route: 'site.list'} %}
    {% endif %}
</div>
{% include 'Web/Shared/Modal/modal.twig' %}
{% include 'Web/Shared/Listing/row-actions-sheet.twig' %}
