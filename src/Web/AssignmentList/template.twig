{% do this.setTitle(t('Assignments')) %}
{% do assetManager.register('App\\Web\\Shared\\Layout\\Main\\AssignmentAsset') %}
{% set showActions = access.can('assignment.update') or access.can('assignment.delete') %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">{{ t('Assignments') }}</h1>
    <div class="d-flex flex-wrap gap-2">
        {% if access.can('assignment.create') %}
            <a class="btn btn-primary" href="{{ urlGenerator.generate('assignment.create') }}" data-modal-link>{{ t('New assignment') }}</a>
        {% endif %}
    </div>
</div>
{% include 'Web/Shared/Listing/search-form.twig' with {route: 'assignment.list', placeholder: t('Employee, work item or site')} %}
<div data-list-results>
    {% if chips is not empty %}
        {% set filterLabels = {employee: t('Employee'), workItem: t('Work item'), site: t('Construction site')} %}
        <div class="d-flex flex-wrap gap-2 mb-3">
            {% for chip in chips %}
                <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle d-inline-flex align-items-center gap-2 fs-6 fw-normal">
                    {{ t('{label}: {name}', {label: filterLabels[chip.filter], name: chip.name}) }}
                    <a class="link-body-emphasis text-decoration-none" href="{{ urlGenerator.generate('assignment.list', [], {sort: paginator.getSort().getOrderAsString(), q: q ?: null}|merge(chip.without)) }}" aria-label="{{ t('Clear filter') }}" title="{{ t('Clear filter') }}">×</a>
                </span>
            {% endfor %}
        </div>
    {% endif %}
    {% if paginator.getTotalItems() == 0 and q != '' %}
        {% include 'Web/Shared/Listing/empty-state.twig' with {message: t('No results for “{query}”.', {query: q})} %}
    {% elseif paginator.getTotalItems() == 0 and filters is not empty %}
        {% include 'Web/Shared/Listing/empty-state.twig' with {message: t('No assignments match the filter.')} %}
    {% elseif paginator.getTotalItems() == 0 %}
        {% include 'Web/Shared/Listing/empty-state.twig' with {message: t('No assignments yet.')} %}
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle assignment-table">
                <thead>
                    <tr>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Employee'), key: 'employee', route: 'assignment.list'} %}</th>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Work item'), key: 'workItem', route: 'assignment.list'} %}</th>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Construction site'), key: 'site', route: 'assignment.list'} %}</th>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('Start date'), key: 'startDate', route: 'assignment.list'} %}</th>
                        <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: t('End date'), key: 'endDate', route: 'assignment.list'} %}</th>
                        <th scope="col">{{ t('Status') }}</th>
                        {% if showActions %}
                            <th scope="col" class="text-end list-actions">{{ t('Actions') }}</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set item = row.item %}
                        <tr class="{{ row.status.stripeClass() }}">
                            <td>{% include 'Web/Shared/Listing/truncated-text.twig' with {text: item.employeeName} %}</td>
                            <td>{% include 'Web/Shared/Listing/truncated-text.twig' with {text: item.workItemName} %}</td>
                            <td>{% include 'Web/Shared/Listing/truncated-text.twig' with {text: item.constructionSiteName} %}</td>
                            <td class="text-nowrap">{{ item.assignment.startDate|date('Y-m-d') }}</td>
                            <td class="text-nowrap">{{ item.assignment.endDate|date('Y-m-d') }}</td>
                            <td>
                                <span class="badge {{ row.status.badgeClass() }}">{{ t(row.status.label()) }}</span>
                                {% if item.accessLevelTooLow() %}
                                    {% include 'Web/Shared/Access/access-level-too-low-badge.twig' with {item: item} %}
                                {% endif %}
                            </td>
                            {% if showActions %}
                                {% set actions = [] %}
                                {% if access.can('assignment.update') %}
                                    {% set actions = actions|merge([
                                        {label: t('Edit'), url: urlGenerator.generate('assignment.edit', {id: item.assignment.id}), variant: 'primary'},
                                        {label: t('Reassign'), url: urlGenerator.generate('assignment.edit', {id: item.assignment.id}) ~ '#employee', variant: 'secondary'},
                                    ]) %}
                                {% endif %}
                                {% if access.can('assignment.delete') %}
                                    {% set actions = actions|merge([{label: t('Delete'), url: urlGenerator.generate('assignment.delete', {id: item.assignment.id}), variant: 'danger'}]) %}
                                {% endif %}
                                <td class="text-end text-nowrap list-actions">{% include 'Web/Shared/Listing/row-actions.twig' with {name: item.employeeName ~ ' – ' ~ item.workItemName, actions: actions} %}</td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% include 'Web/Shared/Listing/pagination.twig' with {route: 'assignment.list'} %}
    {% endif %}
</div>
{% include 'Web/Shared/Modal/modal.twig' %}
{% include 'Web/Shared/Listing/row-actions-sheet.twig' %}
