    <h1 class="h3 mb-0">{{ t('My work calendar') }}</h1>
    <a class="btn btn-outline-secondary" href="{{ urlGenerator.generate('my-assignments') }}">{{ t('List') }}</a>
</div>
<div class="mb-3">
    {% include 'Web/Shared/Calendar/month-nav.twig' with {calendar: calendar, route: 'my-assignments.calendar', query: {}} %}
