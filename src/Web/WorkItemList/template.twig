{% do this.setTitle('Work items') %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Work items</h1>
    {% if access.can('workItem.create') %}
        <a class="btn btn-primary" href="{{ urlGenerator.generate('workItem.create') }}">Add work item</a>
    {% endif %}
</div>
{% include 'Web/Shared/Listing/search-form.twig' with {route: 'workItem.list', placeholder: 'Name or description'} %}
{% if paginator.getTotalItems() == 0 and q != '' %}
    <p class="text-secondary">No results for “{{ q }}”.</p>
{% elseif paginator.getTotalItems() == 0 %}
    <p class="text-secondary">No work items yet.</p>
{% else %}
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">{% include 'Web/Shared/Listing/sort-link.twig' with {label: 'Name', key: 'name', route: 'workItem.list'} %}</th>
                    <th scope="col">Description</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for workItem in paginator.read() %}
                    <tr>
                        <td>{{ workItem.name }}</td>
                        <td>{{ workItem.description|length > 100 ? workItem.description|slice(0, 100) ~ '…' : workItem.description }}</td>
                        <td class="text-end text-nowrap">
                            {% if access.can('workItem.update') %}
                                <a class="btn btn-sm btn-outline-primary" href="{{ urlGenerator.generate('workItem.edit', {id: workItem.id}) }}">Edit</a>
                            {% endif %}
                            {% if access.can('workItem.delete') %}
                                <a class="btn btn-sm btn-outline-danger" href="{{ urlGenerator.generate('workItem.delete', {id: workItem.id}) }}">Delete</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% include 'Web/Shared/Listing/pagination.twig' with {route: 'workItem.list'} %}
{% endif %}
